{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "threadsift",
  "main": "src/targets/worker/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/share"],
  },
  "d1_databases": [{ "binding": "DB", "database_name": "threadsift" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "threadsift-files" }],
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "threadsift-jobs" }],
    "consumers": [{ "queue": "threadsift-jobs", "max_batch_size": 1 }],
  },
  "triggers": { "crons": ["* * * * *"] },
  "limits": { "cpu_ms": 300000 },
  "alias": {
    "turndown": "turndown/lib/turndown.cjs.js",
    "@mixmark-io/domino": "@mixmark-io/domino/lib/index.js",
  },
}
