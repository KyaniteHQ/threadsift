{
  "name": "threadsift",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:worker": "node tools/check-worker-size.ts",
    "build:extension": "pnpm --filter threadsift-extension run build && pnpm --filter threadsift-extension run build:firefox",
    "deploy": "node tools/deploy-worker.ts",
    "check": "pnpm run fmt:check && pnpm run check:extension && pnpm run lint && pnpm run check:doc-refs && pnpm run check:core-layout",
    "check:core-layout": "node tools/check-core-layout.ts",
    "check:doc-refs": "node tools/doc-refs.ts",
    "check:extension": "pnpm --filter threadsift-extension run check",
    "check:faces": "node tools/check-font-faces.ts",
    "docs:impact": "node tools/docs-impact.ts",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --format=agent",
    "lint:extension": "pnpm --filter threadsift-extension run lint:firefox",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "test": "node --test test/"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.105",
    "@ai-sdk/openai": "4.0.118",
    "@ai-sdk/openai-compatible": "3.0.92",
    "@ai-sdk/xai": "5.0.46",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/eb-garamond": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/cal-sans": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/fira-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@hono/node-server": "2.1.8",
    "@hono/zod-openapi": "1.6.3",
    "@mixmark-io/domino": "2.2.0",
    "@modelcontextprotocol/server": "2.4.0",
    "ai": "7.0.173",
    "defuddle": "catalog:",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "linkedom": "0.18.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "turndown": "7.2.5",
    "unified": "11.0.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@oxlint/plugins": "1.94.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "jsonc-parser": "3.3.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0",
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Stores the library and owner settings in D1."
      },
      "FILES": {
        "description": "Stores Item images, post text, and Export files in R2."
      },
      "JOBS": {
        "description": "Queues fetches, Digests, and library wiki work."
      },
      "AI": {
        "description": "Runs Digests and library wiki tasks with Workers AI when the owner selects it as the Provider."
      },
      "ASSETS": {
        "description": "Serves the web app built from this repository."
      },
      "THREADSIFT_SECRET_KEY": {
        "description": "Generate a 64-character hexadecimal key with `openssl rand -hex 32`. It encrypts stored Provider keys and tokens. Keep it for the lifetime of the Instance."
      },
      "SETUP_CODE": {
        "description": "Generate a 32-character setup code with `openssl rand -hex 16`, or use a code of at least 16 characters. Enter it on the setup page to create the owner."
      }
    }
  }
}
